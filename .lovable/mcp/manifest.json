{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qjwrnrvzdnyyrtwvrbem.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "project-chronicle-mcp",
      "version": "0.1.0",
      "title": "Project Chronicle"
    },
    "tools": [
      {
        "name": "list_incidents",
        "title": "List incidents",
        "description": "List the signed-in user's recorded workplace incidents in reverse chronological order (most recent incident_date first). Returns id, title, incident_date, category, subtype, severity, and a short summary. Does not return raw narrative or attachments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of incidents to return (1-100)."
            },
            "category": {
              "type": "string",
              "description": "Optional exact category filter, e.g. 'Communication'."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_incident",
        "title": "Get incident",
        "description": "Fetch a single incident record belonging to the signed-in user by its id. Returns the full incident row including raw_narrative and ai_summary.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Incident UUID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_incident",
        "title": "Create incident record",
        "description": "Create a new workplace incident record for the signed-in user. The user's own words are preserved verbatim in raw_narrative — do not paraphrase. Optional structured fields (title, incident_date, location, people_involved, category) may be supplied when clearly stated by the user; leave them blank otherwise.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "raw_narrative": {
              "type": "string",
              "minLength": 1,
              "description": "The user's account of the incident, preserved verbatim in their own words."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short title for the record."
            },
            "incident_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Date the incident occurred, YYYY-MM-DD."
            },
            "location": {
              "type": "string",
              "description": "Where the incident took place."
            },
            "people_involved": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Names of people involved."
            },
            "category": {
              "type": "string",
              "description": "Primary category, if clearly stated."
            }
          },
          "required": [
            "raw_narrative"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
